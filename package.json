{
  "name": "poe-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @poe-tools/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "probe": "pnpm --filter @poe-tools/data-job probe",
    "probe:exchange": "pnpm --filter @poe-tools/data-job probe:exchange",
    "probe:base-items": "pnpm --filter @poe-tools/data-job probe:base-items",
    "probe:poe1": "pnpm --filter @poe-tools/data-job probe:poe1",
    "job": "pnpm --filter @poe-tools/data-job job"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
